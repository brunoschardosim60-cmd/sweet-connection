# External Supabase project. Use only the publishable key in browser builds.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_URL=https://your-project.supabase.co
ASAAS_API_URL=https://api.asaas.com/v3
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Servidor somente: necessário para rotas protegidas (billing, sitemap e notificações).
# Nunca prefixe com VITE_ nem exponha este valor ao navegador.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_server_key

# Absolute production origin used by SSR for canonical and Open Graph URLs.
VITE_PUBLIC_SITE_URL=https://your-production-host.example

# Server-side only: direct Gemini generation. Do not prefix with VITE_ and never expose this key.
GEMINI_API_KEY=your_google_ai_studio_key
# Optional; defaults to gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# Optional notifications. E-mail uses Resend; WhatsApp uses Meta Cloud API.
RESEND_API_KEY=re_your_key
NOTIFICATION_EMAIL_FROM=Nexa <notificacoes@your-domain.example>
WHATSAPP_ACCESS_TOKEN=your_meta_access_token
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
