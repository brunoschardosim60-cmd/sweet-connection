# External Supabase project. Use only the publishable key in browser builds.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Absolute production origin used by SSR for canonical and Open Graph URLs.
VITE_PUBLIC_SITE_URL=https://your-production-host.example
